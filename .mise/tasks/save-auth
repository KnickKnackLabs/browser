#!/usr/bin/env bash
#MISE description="Save browser auth state for a site"
#USAGE example "browser save-auth github.com" header="Save current site authentication"
#USAGE arg "<site>" help="Site to save auth for (e.g. github.com)"
#USAGE flag "-b --browser <browser>" help="Browser ID (default: agent's latest browser)"

set -euo pipefail
source "$MISE_CONFIG_ROOT/lib/identity.sh"

SITE="${usage_site:?Usage: browser save-auth <site>}"
BROWSER_ID="${usage_browser:-}"

ARGS=(--action save-auth --agent "$AGENT" --site "$SITE")
[ -n "$BROWSER_ID" ] && ARGS+=(--browser "$BROWSER_ID")

node "$MISE_CONFIG_ROOT/scripts/_cdp.mjs" "${ARGS[@]}"
