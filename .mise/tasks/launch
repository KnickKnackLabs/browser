#!/usr/bin/env bash
#MISE description="Launch a named profile or a temporary browser"
#USAGE example "browser launch --profile rentals --headed" header="Open a persistent rental-research profile"
#USAGE example "browser launch --temporary" header="Open an isolated temporary browser"
#USAGE flag "--profile <name>" help="Existing named profile"
#USAGE flag "--temporary" help="Use disposable browser data"
#USAGE flag "--headed" help="Show the browser window"
set -euo pipefail
source "$MISE_CONFIG_ROOT/lib/runtime.sh"

args=(launch)
[ -z "${usage_profile:-}" ] || args+=(--profile "$usage_profile")
[ "${usage_temporary:-false}" != true ] || args+=(--temporary)
[ "${usage_headed:-false}" != true ] || args+=(--headed)
node "$MISE_CONFIG_ROOT/scripts/browsers.mjs" ${args[@]+"${args[@]}"}
