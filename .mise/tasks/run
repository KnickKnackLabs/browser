#!/usr/bin/env bash
#MISE description="Run a Playwright script in a temporary or running browser"
#USAGE example "browser run github-avatar-upload /path/to/avatar.png" header="Run a saved Playwright workflow"
#USAGE arg "<script>" help="Script name (built-in) or path to .mjs file"
#USAGE arg "[args...]" var=#true help="Arguments to pass to the script"
#USAGE flag "-b --browser <browser>" help="Browser ID to run against (persistent browser)"
#USAGE flag "--headed" help="Run with visible browser"

set -euo pipefail
source "$MISE_CONFIG_ROOT/lib/identity.sh"
source "$MISE_CONFIG_ROOT/lib/patchright.sh"

SCRIPT_NAME="${usage_script:?Usage: browser run <script> [args...]}"
HEADED="${usage_headed:-false}"
BROWSER_ID="${usage_browser:-}"

# Safe variadic arg parsing (no eval — see or#146)
SCRIPT_ARGS=()
if [ -n "${usage_args:-}" ]; then
  if PARSED_ARGS=$(printf '%s' "${usage_args}" | xargs printf '%s\n'); then
    while IFS= read -r arg; do
      SCRIPT_ARGS+=("$arg")
    done <<< "$PARSED_ARGS"
  else
    parse_status=$?
    echo "Failed to parse script arguments." >&2
    exit "$parse_status"
  fi
fi

# Resolve script: absolute path or built-in name
if [ -f "$SCRIPT_NAME" ]; then
  SCRIPT_PATH="$(cd "$(dirname "$SCRIPT_NAME")" && pwd)/$(basename "$SCRIPT_NAME")"
elif [ -f "$MISE_CONFIG_ROOT/scripts/${SCRIPT_NAME}.mjs" ]; then
  SCRIPT_PATH="$MISE_CONFIG_ROOT/scripts/${SCRIPT_NAME}.mjs"
else
  echo "Script not found: $SCRIPT_NAME" >&2
  echo "" >&2
  echo "Built-in scripts:" >&2
  for script in "$MISE_CONFIG_ROOT"/scripts/*.mjs; do
    [ -e "$script" ] || continue
    name="$(basename "$script" .mjs)"
    [[ "$name" == _* ]] && continue
    printf '  %s\n' "$name" >&2
  done
  exit 1
fi

ensure_patchright_node_module

CACHE="$(cache_dir)"
if [ -z "$BROWSER_ID" ] && { [ ! -d "$CACHE" ] || ! ls "$CACHE"/chromium-* &>/dev/null; }; then
  echo "Chromium not installed. Run: browser setup" >&2
  exit 1
fi

echo "Running: $(basename "$SCRIPT_PATH" .mjs)"
echo "  Agent: $AGENT"
[ -n "$BROWSER_ID" ] && echo "  Browser: $BROWSER_ID"
echo ""

HARNESS_ARGS=(
  --script "$SCRIPT_PATH"
  --headed "$HEADED"
)
[ -n "$BROWSER_ID" ] && HARNESS_ARGS+=(--browser "$BROWSER_ID")

node "$MISE_CONFIG_ROOT/scripts/_harness.mjs" \
  ${HARNESS_ARGS[@]+"${HARNESS_ARGS[@]}"} \
  -- "${SCRIPT_ARGS[@]+"${SCRIPT_ARGS[@]}"}"
