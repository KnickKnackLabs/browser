#!/usr/bin/env bash
#MISE description="Scroll the browser viewport by pixel deltas"
#USAGE example "browser scroll --browser b-a1f3 --x 400 --y -200" header="Scroll by signed pixel deltas"
#USAGE flag "--x <pixels>" help="Horizontal delta in pixels (default: 0)"
#USAGE flag "--y <pixels>" help="Vertical delta in pixels (default: 0)"
#USAGE flag "-b --browser <browser>" help="Required browser ID returned by launch"

set -euo pipefail
source "$MISE_CONFIG_ROOT/lib/runtime.sh"

X="${usage_x:-0}"
Y="${usage_y:-0}"
BROWSER_ID="${usage_browser:?Pass --browser ID}"

ARGS=(--action scroll --browser "$BROWSER_ID" --x "$X" --y "$Y")

node "$MISE_CONFIG_ROOT/scripts/_cdp.mjs" ${ARGS[@]+"${ARGS[@]}"}
