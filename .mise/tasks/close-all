#!/usr/bin/env bash
#MISE description="Close every browser in this user's managed registry"
#USAGE example "browser close-all --all" header="Explicitly close every managed browser"
#USAGE flag "--all" help="Approve closing every managed browser"
set -euo pipefail
source "$MISE_CONFIG_ROOT/lib/runtime.sh"

if [ "${usage_all:-false}" != true ]; then
  echo 'Use --all to approve closing every managed browser.' >&2
  exit 1
fi
node "$MISE_CONFIG_ROOT/scripts/browsers.mjs" close-all --all
