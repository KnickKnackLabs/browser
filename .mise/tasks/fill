#!/usr/bin/env bash
#MISE description="Fill an input field in the browser"
#USAGE example "browser fill 'input[name=q]' 'browser automation'" header="Fill an input"
#USAGE arg "<selector>" help="CSS selector for the input"
#USAGE arg "<value>" help="Value to fill"
#USAGE flag "-b --browser <browser>" help="Browser ID (default: agent's latest browser)"

set -euo pipefail
source "$MISE_CONFIG_ROOT/lib/identity.sh"

SELECTOR="${usage_selector:?Usage: browser fill <selector> <value>}"
VALUE="${usage_value:?Usage: browser fill <selector> <value>}"
BROWSER_ID="${usage_browser:-}"

ARGS=(--action fill --agent "$AGENT" --selector "$SELECTOR" --value "$VALUE")
[ -n "$BROWSER_ID" ] && ARGS+=(--browser "$BROWSER_ID")

node "$MISE_CONFIG_ROOT/scripts/_cdp.mjs" ${ARGS[@]+"${ARGS[@]}"}
