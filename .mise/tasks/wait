#!/usr/bin/env bash
#MISE description="Wait for an element to appear in the browser"
#USAGE example "browser wait '#results' --timeout 10000" header="Wait for an element"
#USAGE arg "<selector>" help="CSS selector to wait for"
#USAGE flag "-t --timeout <timeout>" help="Timeout in milliseconds (default: 30000)"
#USAGE flag "-b --browser <browser>" help="Browser ID (default: agent's latest browser)"

set -euo pipefail
source "$MISE_CONFIG_ROOT/lib/identity.sh"

SELECTOR="${usage_selector:?Usage: browser wait <selector>}"
TIMEOUT="${usage_timeout:-30000}"
BROWSER_ID="${usage_browser:-}"

ARGS=(--action wait --agent "$AGENT" --selector "$SELECTOR" --timeout "$TIMEOUT")
[ -n "$BROWSER_ID" ] && ARGS+=(--browser "$BROWSER_ID")

node "$MISE_CONFIG_ROOT/scripts/_cdp.mjs" "${ARGS[@]}"
