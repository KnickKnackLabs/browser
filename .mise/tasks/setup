#!/usr/bin/env bash
#MISE description="Install Patchright browser (Chromium only)"
#USAGE example "browser setup" header="Install the managed Chromium browser"

set -euo pipefail

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/browser"
export PLAYWRIGHT_BROWSERS_PATH="$CACHE_DIR"

echo "Installing Patchright Chromium..."
echo "  Browser cache: $CACHE_DIR"
echo ""

# Use mise's managed patchright (version pinned in mise.toml), not npx
# which may resolve a different version from the global npm cache.
# The runtime scripts import patchright from the same mise-managed install,
# so the chromium build must match.
patchright install chromium

echo ""
echo "Done. Run: browser login <site>"
