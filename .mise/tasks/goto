#!/usr/bin/env bash
#MISE description="Navigate browser to a URL"
#USAGE example "browser goto --browser b-a1f3 https://example.com" header="Navigate a selected browser"
#USAGE arg "<url>" help="URL to navigate to"
#USAGE flag "-b --browser <browser>" help="Required browser ID returned by launch"

set -euo pipefail
source "$MISE_CONFIG_ROOT/lib/runtime.sh"

URL="${usage_url:?Usage: browser goto <url>}"
BROWSER_ID="${usage_browser:?Pass --browser ID}"

ARGS=(--action goto --browser "$BROWSER_ID")

node "$MISE_CONFIG_ROOT/scripts/_cdp.mjs" ${ARGS[@]+"${ARGS[@]}"} "$URL"
