#!/usr/bin/env bash
#MISE description="Navigate browser to a URL"
#USAGE example "browser goto https://example.com" header="Navigate the latest browser"
#USAGE arg "<url>" help="URL to navigate to"
#USAGE flag "-b --browser <browser>" help="Browser ID (default: agent's latest browser)"

set -euo pipefail
source "$MISE_CONFIG_ROOT/lib/identity.sh"

URL="${usage_url:?Usage: browser goto <url>}"
BROWSER_ID="${usage_browser:-}"

ARGS=(--action goto --agent "$AGENT")
[ -n "$BROWSER_ID" ] && ARGS+=(--browser "$BROWSER_ID")

node "$MISE_CONFIG_ROOT/scripts/_cdp.mjs" ${ARGS[@]+"${ARGS[@]}"} "$URL"
