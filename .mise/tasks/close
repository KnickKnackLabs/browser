#!/usr/bin/env bash
#MISE description="Close one managed browser gracefully"
#USAGE example "browser close b-a1f3" header="Close a browser by ID"
#USAGE arg "<browser_id>" help="Browser ID returned by launch"
set -euo pipefail
source "$MISE_CONFIG_ROOT/lib/runtime.sh"

node "$MISE_CONFIG_ROOT/scripts/browsers.mjs" close "$usage_browser_id"
