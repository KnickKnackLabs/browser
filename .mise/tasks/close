#!/usr/bin/env bash
#MISE description="Close a browser instance"
#USAGE example "browser close b-a1f3" header="Close one browser by ID"
#USAGE arg "[browser_id]" help="Browser ID to close (default: agent's latest browser)"

set -euo pipefail
source "$MISE_CONFIG_ROOT/lib/identity.sh"

BROWSER_ID="${usage_browser_id:-}"

if [ -n "$BROWSER_ID" ]; then
  PID_FILE="$(pid_file_for_id "$BROWSER_ID")"

  if [ ! -f "$PID_FILE" ]; then
    echo "No browser found with ID $BROWSER_ID (already closed)"
    exit 0
  fi

  PID=$(jq -r '.pid' "$PID_FILE" 2>/dev/null || echo "")
  FILE_AGENT=$(jq -r '.agent' "$PID_FILE" 2>/dev/null || echo "")

  if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
    if ! kill "$PID" 2>/dev/null; then
      echo "Failed to close browser $BROWSER_ID (pid $PID)" >&2
      exit 1
    fi
    echo "Browser $BROWSER_ID closed (pid $PID)"
  else
    echo "Browser $BROWSER_ID was not running (stale PID file)"
  fi

  rm -f "$PID_FILE"

  # Clean up agent-default PID file if it points to this browser
  if [ -n "$FILE_AGENT" ]; then
    AGENT_PID_FILE="$(pid_file_for_agent "$FILE_AGENT")"
    if [ -f "$AGENT_PID_FILE" ]; then
      AGENT_FILE_ID=$(jq -r '.id // empty' "$AGENT_PID_FILE" 2>/dev/null || echo "")
      if [ "$AGENT_FILE_ID" = "$BROWSER_ID" ]; then
        rm -f "$AGENT_PID_FILE"
      fi
    fi
  fi
else
  PID_FILE="$(pid_file_for_agent)"

  if [ ! -f "$PID_FILE" ]; then
    echo "No browser running for $AGENT"
    exit 0
  fi

  PID=$(jq -r '.pid' "$PID_FILE" 2>/dev/null || echo "")
  CLOSED_ID=$(jq -r '.id // empty' "$PID_FILE" 2>/dev/null || echo "")

  if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
    if ! kill "$PID" 2>/dev/null; then
      echo "Failed to close browser for $AGENT (pid $PID)" >&2
      exit 1
    fi
    echo "Browser closed for $AGENT (pid $PID)"
  else
    echo "Browser was not running (stale PID file)"
  fi

  rm -f "$PID_FILE"

  if [ -n "$CLOSED_ID" ]; then
    rm -f "$(pid_file_for_id "$CLOSED_ID")"
  fi
fi
