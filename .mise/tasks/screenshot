#!/usr/bin/env bash
#MISE description="Take a screenshot of the browser"
#USAGE flag "--stdout" help="Write PNG to stdout instead of a file"
#USAGE flag "-b --browser <browser>" help="Browser ID (default: agent's latest browser)"

set -euo pipefail
source "$MISE_CONFIG_ROOT/lib/identity.sh"

STDOUT="${usage_stdout:-false}"
BROWSER_ID="${usage_browser:-}"

ARGS=(--action screenshot --agent "$AGENT")
[ "$STDOUT" = "true" ] && ARGS+=(--stdout)
[ -n "$BROWSER_ID" ] && ARGS+=(--browser "$BROWSER_ID")

node "$MISE_CONFIG_ROOT/scripts/_cdp.mjs" "${ARGS[@]}"
